# Minimal runtime image around a prebuilt release binary.
# The workflow places the binary at docker-dist/zdns-rest.
FROM alpine:3.19

RUN apk --no-cache add ca-certificates && \
    addgroup -S zdns && adduser -S -G zdns -H zdns

WORKDIR /home/zdns

COPY docker-dist/zdns-rest ./zdns-rest

USER zdns

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ping || exit 1

ENTRYPOINT ["./zdns-rest"]
CMD ["--bind-port", "8080", "--bind-ip", "0.0.0.0"]
